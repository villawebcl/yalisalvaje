---
import { supabase } from "../../lib/supabaseClient";
import { buildOptimizedImageUrl, buildResponsiveSrcSet } from "../../lib/imageUtils";

const { data: featuredSetting, error: featuredError } = await supabase
  .from("site_settings")
  .select("value")
  .eq("key", "featured_gallery_limit")
  .maybeSingle();

if (featuredError) {
  console.error("Error al cargar límite de destacadas:", featuredError);
}

const featuredLimit = Math.max(1, Number(featuredSetting?.value) || 6);

const { data: fotos, error } = await supabase
  .from("imagenes")
  .select("id, url_publica, alt_text, descripcion, detalle, destacada_orden")
  .eq("destacada", true)
  .order("destacada_orden", { ascending: true, nullsFirst: false })
  .order("created_at", { ascending: false })
  .limit(featuredLimit);

if (error) {
  console.error("Error al cargar fotos destacadas:", error);
}

const fotosDestacadas = fotos ?? [];
---

<section class="pictures">
  <div class="container">
    <div class="title">
      <p class="kicker">Galería destacada</p>
      <h2>Fotografías del Yali</h2>
    </div>

    {fotosDestacadas.length === 0 ? (
      <div class="empty">
        <p>Aún no hay fotos destacadas.</p>
        <p>Publica imágenes desde el panel para que aparezcan aquí.</p>
      </div>
    ) : (
      <div class="carousel-wrap">
        <div class="carousel-viewport" id="carousel-viewport">
          <div class="carousel-track" id="carousel-track">
            {fotosDestacadas.map((foto, index) => (
              <figure class="carousel-slide">
                <a
                  class="slide-link"
                  href={`/galeria?foto=${encodeURIComponent(String(foto.id))}`}
                  aria-label={`Ampliar en la galería: ${foto.descripcion ?? foto.alt_text ?? "fotografía del humedal"}`}
                >
                  <img
                    src={buildOptimizedImageUrl(foto.url_publica, { width: 1000, quality: 72 })}
                    srcset={buildResponsiveSrcSet(foto.url_publica, { widths: [500, 800, 1000], quality: 72 }) || undefined}
                    sizes="(max-width: 768px) 100vw, 780px"
                    alt={foto.alt_text ?? "Fotografía del humedal"}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <figcaption>
                    <span class="slide-title">{foto.descripcion ?? foto.alt_text ?? "Sin descripción"}</span>
                    {foto.detalle ? <span class="slide-detail">{foto.detalle}</span> : null}
                  </figcaption>
                </a>
              </figure>
            ))}
          </div>
        </div>

        {fotosDestacadas.length > 1 ? (
          <>
            <button class="carousel-btn prev" type="button" aria-label="Fotografía anterior">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="m15 18-6-6 6-6"></path>
              </svg>
            </button>
            <button class="carousel-btn next" type="button" aria-label="Fotografía siguiente">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </button>
          </>
        ) : null}

        <p class="carousel-counter" id="carousel-counter" aria-live="polite">
          1 / {fotosDestacadas.length}
        </p>
      </div>
    )}

    <div class="cta">
      <a class="button" href="/galeria">Ver galería completa</a>
    </div>
  </div>
</section>

<script>
  const viewport = document.getElementById("carousel-viewport") as HTMLElement | null;
  const track = document.getElementById("carousel-track") as HTMLElement | null;

  if (viewport && track) {
    const carousel = viewport.closest<HTMLElement>(".carousel-wrap");
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".carousel-slide"));
    const counter = carousel?.querySelector<HTMLElement>("#carousel-counter");
    const total = slides.length;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    let suppressNextLink = false;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Asigna ancho exacto del viewport a cada slide (evita el corte)
  function setWidths() {
    const w = viewport.offsetWidth;
    slides.forEach(s => { s.style.width = w + "px"; });
    track.style.transform = `translateX(-${current * viewport.offsetWidth}px)`;
  }

  function goTo(index: number) {
    current = ((index % total) + total) % total;
    track.style.transform = `translateX(-${current * viewport.offsetWidth}px)`;
    if (counter) counter.textContent = `${current + 1} / ${total}`;
  }

  function stopAuto() {
    if (timer) clearInterval(timer);
    timer = undefined;
  }

  function startAuto() {
    stopAuto();
    const userIsInteracting = carousel?.matches(":hover") || carousel?.contains(document.activeElement);
    if (total > 1 && !userIsInteracting && !prefersReducedMotion.matches) {
      timer = setInterval(() => goTo(current + 1), 4500);
    }
  }

  // Init
  setWidths();
  startAuto();

  window.addEventListener("resize", setWidths);

  carousel?.querySelector(".carousel-btn.prev")?.addEventListener("click", () => { goTo(current - 1); startAuto(); });
  carousel?.querySelector(".carousel-btn.next")?.addEventListener("click", () => { goTo(current + 1); startAuto(); });
  carousel?.addEventListener("mouseenter", stopAuto);
  carousel?.addEventListener("mouseleave", startAuto);
  carousel?.addEventListener("focusin", stopAuto);
  carousel?.addEventListener("focusout", (event) => {
    if (!(event.relatedTarget instanceof Node) || !carousel?.contains(event.relatedTarget)) startAuto();
  });

  // Swipe táctil con feedback visual
  let startX = 0;
  let isDragging = false;

  viewport.addEventListener("touchstart", (e) => { 
    startX = e.touches[0].clientX; 
    isDragging = true;
    suppressNextLink = false;
    track.style.transition = "none";
    stopAuto();
  }, { passive: true });

  viewport.addEventListener("touchmove", (e) => {
    if (!isDragging) return;
    const currentX = e.touches[0].clientX;
    const diff = currentX - startX;
    const baseTranslate = -(current * viewport.offsetWidth);
    track.style.transform = `translateX(${baseTranslate + diff}px)`;
  }, { passive: true });

  viewport.addEventListener("touchend", (e) => {
    if (!isDragging) return;
    isDragging = false;
    track.style.transition = "transform 0.55s cubic-bezier(0.4, 0, 0.2, 1)";
    const diff = startX - e.changedTouches[0].clientX;
    
    if (Math.abs(diff) > 40) { 
      suppressNextLink = true;
      window.setTimeout(() => { suppressNextLink = false; }, 400);
      goTo(diff > 0 ? current + 1 : current - 1); 
    } else {
      goTo(current);
    }
    startAuto();
  });

  carousel?.addEventListener("click", (event) => {
    const clickedLink = event.target instanceof Element
      ? event.target.closest(".slide-link")
      : null;
    if (!suppressNextLink || !clickedLink) return;
    event.preventDefault();
    suppressNextLink = false;
  });

  // Limpia el intervalo al navegar entre páginas
  document.addEventListener(
    "astro:before-swap",
    () => {
      stopAuto();
      window.removeEventListener("resize", setWidths);
    },
    { once: true },
  );
  }
</script>

<style>
  .pictures {
    background: var(--paper-2);
    padding: 6rem 0;
  }

  .title {
    text-align: center;
    margin-bottom: 2rem;
  }

  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.25rem;
    font-size: 0.8rem;
    margin: 0 0 0.5rem;
    color: var(--muted);
  }

  h2 {
    font-family: "Alegreya", serif;
    font-size: clamp(2rem, 3vw, 3rem);
    margin: 0;
  }

  /* ── Carrusel centrado y más pequeño ── */
  .carousel-wrap {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
    border-radius: 0.55rem;
    overflow: hidden;
    background: #07100c;
    box-shadow: 0 18px 46px rgba(9, 20, 13, 0.22);
  }

  .carousel-viewport {
    width: 100%;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .carousel-slide {
    flex-shrink: 0;
    margin: 0;
    position: relative;
    background: #dae4db;
  }

  .slide-link {
    position: relative;
    display: block;
    color: inherit;
  }

  .slide-link:focus-visible {
    outline: 3px solid #b7e4c2;
    outline-offset: -4px;
  }

  .carousel-slide img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .carousel-slide figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 3.5rem 4.8rem 1rem 1.2rem;
    background: linear-gradient(0deg, rgba(3, 10, 6, 0.9), transparent);
    color: rgba(255, 255, 255, 0.97);
    transform-origin: left bottom;
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 180ms ease-out;
  }

  .slide-link:focus-visible figcaption {
    transform: scale(1.05);
  }

  @media (hover: hover) {
    .slide-link:hover figcaption {
      transform: scale(1.05);
    }
  }

  .slide-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .slide-detail {
    display: -webkit-box;
    margin-top: 0.25rem;
    color: rgba(240, 248, 242, 0.78);
    font-size: 0.88rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  /* ── Botones sobre el carrusel ── */
  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(7, 16, 12, 0.68);
    color: #f7fbf8;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(2, 8, 5, 0.22);
    backdrop-filter: blur(10px);
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-btn.prev { left: 0.75rem; }
  .carousel-btn.next { right: 0.75rem; }

  .carousel-btn:hover {
    background: rgba(20, 83, 45, 0.9);
    border-color: rgba(255, 255, 255, 0.34);
    transform: translateY(-50%) scale(1.06);
  }

  .carousel-btn:focus-visible {
    outline: 3px solid #b7e4c2;
    outline-offset: 3px;
  }

  .carousel-btn svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .carousel-counter {
    position: absolute;
    right: 1.2rem;
    bottom: 1rem;
    z-index: 10;
    margin: 0;
    color: rgba(240, 248, 242, 0.82);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  /* ── Empty ── */
  .empty {
    background: var(--paper);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow);
    color: var(--muted);
  }
  .empty p { margin: 0 0 0.5rem; }

  /* ── CTA ── */
  .cta {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
  }

  .button {
    background: var(--accent);
    color: white;
    border-radius: 0.32rem;
    padding: 0.9rem 1.8rem;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(47, 107, 76, 0.25);
  }

  @media (max-width: 600px) {
    .carousel-slide img {
      aspect-ratio: 4 / 3;
    }

    .carousel-btn {
      width: 44px;
      height: 44px;
    }

    .carousel-btn.prev { left: 0.5rem; }
    .carousel-btn.next { right: 0.5rem; }

    .carousel-slide figcaption {
      padding: 3rem 4rem 0.8rem 0.9rem;
    }

    .slide-link:hover figcaption,
    .slide-link:focus-visible figcaption {
      transform: none;
    }

    .carousel-counter {
      right: 0.9rem;
      bottom: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track,
    .carousel-slide figcaption,
    .carousel-btn {
      transition-duration: 0.01ms !important;
    }
  }
</style>
