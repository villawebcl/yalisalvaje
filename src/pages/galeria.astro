---
import Layout from "../layouts/Layout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import { supabase } from "../lib/supabaseClient";
import { buildOptimizedImageUrl, buildResponsiveSrcSet } from "../lib/imageUtils";

const { data: fotos, error } = await supabase
  .from("imagenes")
  .select("id, url_publica, alt_text, descripcion, detalle")
  .order("created_at", { ascending: false });

if (error) {
  console.error("Error al cargar la galería:", error);
}

const imagenesGaleria = fotos ?? [];
const INITIAL_BATCH_SIZE = 18;
const getVariantClass = (index) => {
  const mod = index % 12;
  if (mod === 0 || mod === 7) return "v-wide";
  if (mod === 2 || mod === 9) return "v-tall";
  if (mod === 4) return "v-feature";
  return "v-regular";
};
const imagenesIniciales = imagenesGaleria.slice(0, INITIAL_BATCH_SIZE);
const imagenesPayload = JSON.stringify(
  imagenesGaleria.map((foto, index) => ({
    id: foto.id,
    index,
    fullUrl: foto.url_publica,
    thumbUrl: buildOptimizedImageUrl(foto.url_publica, { width: 700, quality: 62 }),
    alt: foto.alt_text ?? "Fotografia del humedal",
    caption: foto.descripcion ?? foto.alt_text ?? "Sin descripcion",
    detail: foto.detalle ?? "",
  })),
);
---

<Layout title="Galería | Yali Salvaje">
  <Header />
  <section class="page">
    <div class="gallery-shell">
      <p class="kicker">Registro fotográfico</p>
      <h1>Galería del Humedal El Yali</h1>

      <div class="mosaic-gallery" id="gallery-grid">
        {
          imagenesGaleria.length === 0 ? (
            <div class="empty">
              <p>Aún no hay fotos en la galería.</p>
              <p>Muy pronto compartiremos nuevas capturas del humedal.</p>
            </div>
          ) : (
            imagenesIniciales.map((foto, index) => (
              <figure
                class={`foto-item ${getVariantClass(index)} media-zoom`}
                tabindex="0"
                role="button"
                aria-label={`Ampliar: ${foto.descripcion ?? foto.alt_text ?? "fotografía del humedal"}`}
              >
                <img
                  src={buildOptimizedImageUrl(foto.url_publica, { width: 700, quality: 62 })}
                  srcset={buildResponsiveSrcSet(foto.url_publica, { widths: [400, 700], quality: 62 }) || undefined}
                  sizes="(max-width: 780px) 50vw, 25vw"
                  alt={foto.alt_text ?? "Fotografía del humedal"}
                  loading="lazy"
                  decoding="async"
                  data-full={foto.url_publica}
                  data-photo-id={foto.id}
                  data-caption={foto.descripcion ?? foto.alt_text ?? "Sin descripción"}
                  data-detail={foto.detalle ?? ""}
                />
                <figcaption>
                  {foto.descripcion ?? foto.alt_text ?? "Sin descripción"}
                  {foto.detalle ? (
                    <span class="caption-detail">{foto.detalle}</span>
                  ) : null}
                </figcaption>
              </figure>
            ))
          )
        }
      </div>
      {
        imagenesGaleria.length > INITIAL_BATCH_SIZE ? (
          <div class="gallery-feed" id="gallery-feed">
            <p class="gallery-loading" id="gallery-loading">Cargando más fotografías...</p>
            <div class="gallery-sentinel" id="gallery-sentinel" aria-hidden="true"></div>
          </div>
        ) : null
      }

      <script type="application/json" id="gallery-data" set:html={imagenesPayload}></script>

      <div
        class="lightbox ui-modal"
        id="lightbox"
        role="dialog"
        aria-modal="true"
        aria-label="Visor de fotografías del Humedal El Yali"
        aria-hidden="true"
        inert
      >
        <div class="ui-modal-overlay" id="lightbox-overlay" aria-hidden="true"></div>
        <div class="lightbox-panel ui-modal-panel">
          <button class="lightbox-close ui-modal-close lightbox-control" type="button" aria-label="Cerrar visor">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
          <button class="lightbox-prev lightbox-control" type="button" aria-label="Fotografía anterior">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button class="lightbox-next lightbox-control" type="button" aria-label="Fotografía siguiente">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
          <div class="lightbox-content">
            <div class="lightbox-stage" id="lightbox-stage" aria-busy="false">
              <img
                id="lightbox-image"
                src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
                alt=""
              />
              <div class="lightbox-loading" id="lightbox-loading" role="status" aria-live="polite" hidden>
                <span class="lightbox-spinner" aria-hidden="true"></span>
                <span>Cargando fotografía…</span>
              </div>
              <div class="lightbox-error" id="lightbox-error" role="alert" hidden>
                <p>No pudimos cargar esta fotografía.</p>
                <button class="lightbox-retry" id="lightbox-retry" type="button">Reintentar</button>
              </div>
            </div>
            <div class="lightbox-meta">
              <div
                class="lightbox-copy"
                role="group"
                aria-label="Información de la fotografía. Enfoca para ampliar."
                tabindex="0"
              >
                <p class="lightbox-title" id="lightbox-caption"></p>
                <p class="lightbox-detail" id="lightbox-detail" hidden></p>
                <p class="lightbox-hint">Desliza o usa las flechas</p>
              </div>
              <p class="lightbox-counter" id="lightbox-counter" aria-live="polite"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const galleryGrid = document.getElementById("gallery-grid");
    const rawData = document.getElementById("gallery-data")?.textContent || "[]";
    const allPhotos = JSON.parse(rawData);
    const initialCount = galleryGrid?.querySelectorAll(".foto-item").length ?? 0;
    let renderedCount = initialCount;
    const BATCH_SIZE = 12;
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightbox-image");
    const lightboxStage = document.getElementById("lightbox-stage");
    const lightboxCaption = document.getElementById("lightbox-caption");
    const lightboxDetail = document.getElementById("lightbox-detail");
    const lightboxCounter = document.getElementById("lightbox-counter");
    const lightboxLoading = document.getElementById("lightbox-loading");
    const lightboxError = document.getElementById("lightbox-error");
    const retryButton = document.getElementById("lightbox-retry");
    const closeButton = lightbox?.querySelector(".lightbox-close");
    const prevButton = lightbox?.querySelector(".lightbox-prev");
    const nextButton = lightbox?.querySelector(".lightbox-next");
    const overlay = document.getElementById("lightbox-overlay");
    const sentinel = document.getElementById("gallery-sentinel");
    const loadingLabel = document.getElementById("gallery-loading");
    let currentIndex = -1;
    let touchStartX = 0;
    let touchStartY = 0;
    let activeGalleryImage = null;
    let lastFocusedElement = null;
    let loadSequence = 0;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const getGalleryImages = () =>
      Array.from(document.querySelectorAll(".foto-item img"));

    const createCard = (foto) => {
      if (!(galleryGrid instanceof HTMLElement)) return;
      const figure = document.createElement("figure");
      const getVariantClass = (index) => {
        const mod = index % 12;
        if (mod === 0 || mod === 7) return "v-wide";
        if (mod === 2 || mod === 9) return "v-tall";
        if (mod === 4) return "v-feature";
        return "v-regular";
      };
      figure.className = `foto-item ${getVariantClass(foto.index || 0)} media-zoom`;
      figure.setAttribute("tabindex", "0");
      figure.setAttribute("role", "button");
      figure.setAttribute("aria-label", `Ampliar: ${foto.caption || foto.alt || "fotografía del humedal"}`);

      const img = document.createElement("img");
      img.src = foto.thumbUrl || foto.fullUrl;
      img.alt = foto.alt || "Fotografia del humedal";
      img.loading = "lazy";
      img.decoding = "async";
      img.setAttribute("data-full", foto.fullUrl || foto.thumbUrl || "");
      img.setAttribute("data-photo-id", String(foto.id || ""));
      img.setAttribute("data-caption", foto.caption || "Sin descripcion");
      img.setAttribute("data-detail", foto.detail || "");

      const figcaption = document.createElement("figcaption");
      figcaption.textContent = foto.caption || "Sin descripcion";
      if (foto.detail) {
        const detail = document.createElement("span");
        detail.className = "caption-detail";
        detail.textContent = foto.detail;
        figcaption.appendChild(detail);
      }

      figure.append(img, figcaption);
      galleryGrid.appendChild(figure);
    };

    const loadNextBatch = () => {
      if (renderedCount >= allPhotos.length) {
        if (loadingLabel instanceof HTMLElement) loadingLabel.style.display = "none";
        if (sentinel instanceof HTMLElement) sentinel.style.display = "none";
        return false;
      }

      const next = allPhotos.slice(renderedCount, renderedCount + BATCH_SIZE);
      next.forEach((foto) => createCard(foto));
      renderedCount += next.length;

      if (renderedCount >= allPhotos.length) {
        if (loadingLabel instanceof HTMLElement) loadingLabel.textContent = "Has visto toda la galería.";
      }
      return true;
    };

    const getBackgroundTargets = () => {
      if (!lightbox) return [];
      const bodySiblings = Array.from(document.body.children)
        .filter((element) => !element.contains(lightbox));
      const mainSiblings = Array.from(document.querySelectorAll("main > *"))
        .filter((element) => !element.contains(lightbox));
      const localSiblings = lightbox.parentElement
        ? Array.from(lightbox.parentElement.children).filter((element) => element !== lightbox)
        : [];
      return [...new Set([...bodySiblings, ...mainSiblings, ...localSiblings])];
    };

    const setBackgroundInert = (value) => {
      getBackgroundTargets().forEach((element) => {
        if (element instanceof HTMLElement) element.inert = value;
      });
    };

    const setLoadingState = (state) => {
      if (!lightboxStage) return;
      const isLoading = state === "loading";
      const hasError = state === "error";
      lightboxStage.classList.toggle("is-loading", isLoading);
      lightboxStage.classList.toggle("has-error", hasError);
      lightboxStage.setAttribute("aria-busy", String(isLoading));
      if (lightboxLoading) lightboxLoading.hidden = !isLoading;
      if (lightboxError) lightboxError.hidden = !hasError;
    };

    const prefetchAdjacentImages = (index) => {
      if (allPhotos.length < 2) return;
      [index - 1, index + 1].forEach((targetIndex) => {
        const safeIndex = (targetIndex + allPhotos.length) % allPhotos.length;
        const src = allPhotos[safeIndex]?.fullUrl;
        if (src) new Image().src = src;
      });
    };

    const renderPhoto = (img, direction = 0) => {
      if (!lightboxImage) return;
      const src = img.getAttribute("data-full") || img.src;
      const caption =
        img.getAttribute("data-caption") ||
        img.closest("figure")?.querySelector("figcaption")?.textContent ||
        img.getAttribute("alt") ||
        "";
      const detail = img.getAttribute("data-detail") || "";
      currentIndex = getGalleryImages().indexOf(img);
      activeGalleryImage = img;

      if (lightboxCaption) lightboxCaption.textContent = caption;
      if (lightboxDetail) {
        lightboxDetail.textContent = detail;
        lightboxDetail.hidden = !detail;
      }
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${getGalleryImages().length}`;
      }

      const requestId = ++loadSequence;
      setLoadingState("loading");
      const nextImage = new Image();
      nextImage.decoding = "async";
      nextImage.onload = async () => {
        try {
          await nextImage.decode();
        } catch {
          // The load event already confirms a usable image.
        }
        if (requestId !== loadSequence) return;

        lightboxImage.classList.remove("is-entering-next", "is-entering-prev", "is-entering-open");
        lightboxImage.setAttribute("src", src);
        lightboxImage.setAttribute("alt", img.alt || "");
        lightboxImage.style.removeProperty("transform");
        lightboxImage.style.removeProperty("transition");
        void lightboxImage.offsetWidth;

        if (!prefersReducedMotion.matches) {
          const animationClass = direction > 0
            ? "is-entering-next"
            : direction < 0
              ? "is-entering-prev"
              : "is-entering-open";
          lightboxImage.classList.add(animationClass);
        }

        setLoadingState("ready");
        prefetchAdjacentImages(currentIndex);
      };
      nextImage.onerror = () => {
        if (requestId === loadSequence) setLoadingState("error");
      };
      nextImage.src = src;
    };

    const openLightbox = (img) => {
      if (!lightbox || !lightboxImage) return;
      const trigger = img.closest(".foto-item");
      lastFocusedElement = trigger instanceof HTMLElement
        ? trigger
        : document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
      lightbox.setAttribute("aria-hidden", "false");
      lightbox.inert = false;
      lightbox.classList.add("is-open");
      setBackgroundInert(true);
      document.body.style.overflow = "hidden";
      renderPhoto(img);
      window.requestAnimationFrame(() => {
        if (closeButton instanceof HTMLElement) closeButton.focus();
      });
    };

    galleryGrid?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const item = target.closest(".foto-item");
      const img = item?.querySelector("img");
      if (img instanceof HTMLImageElement) openLightbox(img);
    });

    galleryGrid?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      const target = event.target;
      if (!(target instanceof HTMLElement) || !target.classList.contains("foto-item")) return;
      event.preventDefault();
      const img = target.querySelector("img");
      if (img instanceof HTMLImageElement) openLightbox(img);
    });

    const closeLightbox = () => {
      if (!lightbox) return;
      loadSequence += 1;
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      lightbox.inert = true;
      setBackgroundInert(false);
      setLoadingState("ready");
      currentIndex = -1;
      activeGalleryImage = null;
      document.body.style.overflow = "";
      const currentUrl = new URL(window.location.href);
      if (currentUrl.searchParams.has("foto")) {
        currentUrl.searchParams.delete("foto");
        window.history.replaceState(
          window.history.state,
          "",
          `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`,
        );
      }
      if (lightboxImage) {
        lightboxImage.style.removeProperty("transform");
        lightboxImage.style.removeProperty("transition");
      }
      if (lastFocusedElement instanceof HTMLElement) lastFocusedElement.focus();
      lastFocusedElement = null;
    };

    const showAtIndex = (index, direction = 0) => {
      const galleryImages = getGalleryImages();
      if (!galleryImages.length) return;
      const safeIndex = (index + galleryImages.length) % galleryImages.length;
      const img = galleryImages[safeIndex];
      if (!img) return;
      renderPhoto(img, direction);
    };

    overlay?.addEventListener("click", closeLightbox);

    closeButton?.addEventListener("click", closeLightbox);
    prevButton?.addEventListener("click", (e) => {
      e.stopPropagation();
      showAtIndex(currentIndex - 1, -1);
    });
    nextButton?.addEventListener("click", (e) => {
      e.stopPropagation();
      showAtIndex(currentIndex + 1, 1);
    });
    retryButton?.addEventListener("click", () => {
      if (activeGalleryImage instanceof HTMLImageElement) renderPhoto(activeGalleryImage);
    });

    let isLightboxDragging = false;

    lightboxImage?.addEventListener("touchstart", (event) => {
      const touch = event.touches[0];
      if (!touch) return;
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      isLightboxDragging = true;
      lightboxImage.style.transition = "none";
    }, { passive: true });

    lightboxImage?.addEventListener("touchmove", (event) => {
      if (!isLightboxDragging) return;
      const touch = event.touches[0];
      if (!touch) return;
      const diffX = touch.clientX - touchStartX;
      const diffY = touch.clientY - touchStartY;
      
      // Permitir arrastrar la imagen horizontalmente
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 10) {
        event.preventDefault();
        lightboxImage.style.transform = `translateX(${diffX}px)`;
      }
    }, { passive: false });

    lightboxImage?.addEventListener("touchend", (event) => {
      if (!isLightboxDragging) return;
      isLightboxDragging = false;
      const touch = event.changedTouches[0];
      if (!touch) return;
      const diffX = touch.clientX - touchStartX;
      const diffY = touch.clientY - touchStartY;
      
      if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY)) {
        lightboxImage.style.removeProperty("transform");
        lightboxImage.style.removeProperty("transition");
        if (diffX > 0) showAtIndex(currentIndex - 1, -1);
        else showAtIndex(currentIndex + 1, 1);
      } else {
        lightboxImage.style.transition = prefersReducedMotion.matches
          ? "none"
          : "transform 180ms cubic-bezier(0.22, 1, 0.36, 1)";
        lightboxImage.style.transform = "translateX(0)";
      }
    });

    const handleKeydown = (event) => {
      if (!lightbox || !lightbox.classList.contains("is-open")) return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeLightbox();
      }
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        showAtIndex(currentIndex - 1, -1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        showAtIndex(currentIndex + 1, 1);
      }
      if (event.key === "Tab") {
        const focusable = Array.from(
          lightbox.querySelectorAll("button:not([disabled]), [href], [tabindex]:not([tabindex='-1'])"),
        ).filter((element) => element instanceof HTMLElement && !element.closest("[hidden]"));
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          if (last instanceof HTMLElement) last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          if (first instanceof HTMLElement) first.focus();
        }
      }
    };

    document.addEventListener("keydown", handleKeydown);

    const requestedPhotoId = new URLSearchParams(window.location.search).get("foto");
    if (requestedPhotoId) {
      let requestedImage = getGalleryImages().find(
        (image) => image.getAttribute("data-photo-id") === requestedPhotoId,
      );
      while (!requestedImage && renderedCount < allPhotos.length) {
        loadNextBatch();
        requestedImage = getGalleryImages().find(
          (image) => image.getAttribute("data-photo-id") === requestedPhotoId,
        );
      }
      if (requestedImage instanceof HTMLImageElement) {
        window.requestAnimationFrame(() => openLightbox(requestedImage));
      }
    }

    const observer =
      sentinel instanceof HTMLElement
        ? new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const loaded = loadNextBatch();
                if (!loaded) observer.disconnect();
              });
            },
            { rootMargin: "900px 0px 900px 0px" },
          )
        : null;

    if (observer && sentinel instanceof HTMLElement) observer.observe(sentinel);

    // Clean up event listener before next navigation
    document.addEventListener(
      "astro:before-swap",
      () => {
        document.removeEventListener("keydown", handleKeydown);
        observer?.disconnect();
        if (lightbox) lightbox.inert = true;
        setBackgroundInert(false);
        document.body.style.overflow = "";
      },
      { once: true },
    );
  });
</script>

<style>
  .page {
    padding: 6.2rem 0 5rem;
    background:
      radial-gradient(circle at 12% 0%, rgba(165, 210, 175, 0.25), transparent 38%),
      radial-gradient(circle at 88% 0%, rgba(190, 215, 245, 0.2), transparent 42%),
      #f6f8f5;
  }

  .gallery-shell {
    width: min(1600px, calc(100vw - 1rem));
    margin: 0 auto;
  }

  h1 {
    font-family: "Alegreya", serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    margin: 0 0 0.75rem;
  }

  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.25rem;
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  .mosaic-gallery {
    margin-top: 2rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 32px;
  }

  .foto-item {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    cursor: pointer;
    border: 1px solid rgba(12, 24, 16, 0.08);
    box-shadow: 0 16px 30px rgba(18, 34, 25, 0.14);
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    background: #dce4da;
  }

  .foto-item.v-regular {
    grid-column: span 3;
    grid-row: span 8;
  }

  .foto-item.v-wide {
    grid-column: span 6;
    grid-row: span 9;
  }

  .foto-item.v-tall {
    grid-column: span 3;
    grid-row: span 12;
  }

  .foto-item.v-feature {
    grid-column: span 6;
    grid-row: span 12;
  }

  .foto-item img {
    width: 100%;
    height: 100%;
    min-height: 100%;
    object-fit: cover;
    display: block;
  }

  .foto-item figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 1rem 0.9rem 0.85rem;
    color: rgba(255, 255, 255, 0.94);
    font-size: 0.88rem;
    line-height: 1.35;
    background: linear-gradient(180deg, rgba(9, 15, 11, 0), rgba(9, 15, 11, 0.78) 62%);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .caption-detail {
    display: none;
  }

  .gallery-feed {
    margin: 1.25rem 0 0;
    display: grid;
    justify-items: center;
  }

  .gallery-loading {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .gallery-sentinel {
    width: 100%;
    height: 2px;
  }

  .lightbox {
    padding: clamp(0.5rem, 2vw, 1.5rem);
  }

  .lightbox-panel {
    width: min(100%, 1280px);
    max-height: min(94dvh, 900px);
    overflow: hidden;
    padding: 0;
    background: #07100c;
    border: 0;
    border-radius: 0.85rem;
    box-shadow: 0 32px 90px rgba(2, 8, 5, 0.5);
    opacity: 0.72;
    transform: translateY(24px) scale(0.965);
    transition:
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 240ms ease-out;
  }

  .lightbox.is-open .lightbox-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .lightbox-content {
    position: relative;
    width: 100%;
    min-height: min(82dvh, 820px);
  }

  .lightbox-stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: min(82dvh, 820px);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 35%, rgba(43, 75, 55, 0.24), transparent 48%),
      #07100c;
  }

  .lightbox img {
    width: 100%;
    height: min(82dvh, 820px);
    object-fit: contain;
    border-radius: 0;
    background: transparent;
    transition:
      opacity 220ms ease-out,
      filter 280ms ease-out;
